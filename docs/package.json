{
  "name": "@deepcrate/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "lint:oxlint": "oxlint . -D correctness --ignore-path .gitignore",
    "lint:oxlint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "lint": "oxlint . -D correctness --ignore-path .gitignore && eslint . --cache",
    "lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore && eslint . --fix --cache",
    "format": "prettier --write .vitepress/ src/"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^1.77.0",
    "eslint-plugin-vue": "^10.10.0",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitepress": "2.0.0-alpha.18"
  }
}
