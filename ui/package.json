{
  "name": "@deepcrate/ui",
  "private": true,
  "version": "0.1.20",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint:oxlint": "oxlint . -D correctness --ignore-path .gitignore",
    "lint:oxlint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "lint": "oxlint . -D correctness --ignore-path .gitignore && eslint . --cache",
    "lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore && eslint . --fix --cache",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.1",
    "pinia": "^4.0.3",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.1",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-oxlint": "^1.85.0",
    "eslint-plugin-vue": "^10.11.1",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "sass": "^1.105.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
