{
  "name": "@deepcrate/ui",
  "private": true,
  "version": "0.1.20",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint:oxlint": "oxlint . -D correctness --ignore-path .gitignore",
    "lint:oxlint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix --cache",
    "lint": "oxlint . -D correctness --ignore-path .gitignore && eslint . --cache",
    "lint:fix": "oxlint . --fix -D correctness --ignore-path .gitignore && eslint . --fix --cache",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.0",
    "pinia": "^4.0.2",
    "primeicons": "^8.0.0",
    "primevue": "^5.0.0",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-oxlint": "^1.75.0",
    "eslint-plugin-vue": "^10.10.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.8"
  }
}
