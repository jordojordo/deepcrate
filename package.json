{
  "name": "deepcrate-monorepo",
  "private": true,
  "scripts": {
    "deps:check": "pnpm list -r",
    "deps:update": "pnpm -r up --latest --interactive",
    "dev": "pnpm --filter server --filter ui dev",
    "docs:dev": "pnpm --filter docs dev"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.1",
      "qs": ">=6.14.2",
      "sqlite3": "^6.0.1",
      "@tootallnate/once": ">=3.0.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sqlite3"
    ]
  }
}
